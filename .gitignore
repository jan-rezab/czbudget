.DS_Store
dist/
.openai/
.wrangler/
*.log
test-results/
playwright-report/
node_modules/
__pycache__/
*.pyc
.venv/

# macOS "duplicate on copy" artefacts - "country-functions 2.js", "entities 3.json",
# "website 2/". These have been created in bulk (~25k files) more than once; the
# patterns below cover both files and directories so they can never be committed.
# Patterns without a slash are matched against the basename at every depth.
* [0-9]
* [0-9].*
* [0-9][0-9]
* [0-9][0-9].*

# Regenerable serving output — see pipeline/config/data_layers.json.
# 580 MB across 28,559 files, rebuilt from the uniform layer each release and hydrated at
# build time by scripts/hydrate-data-layers.mjs. Hashes stay in data/manifest.v1.json, so a
# commit still proves which bytes it served.
data/municipal-expansion/

# Generated municipal profile pages — see pipeline/config/data_layers.json.
# 35,869 files rebuilt from the uniform layer each release and hydrated at build time.
# Output is verified byte-identical run to run; the hub index stays committed because it is
# the one file not under a country subtree, and hashing it keeps verification complete.
municipalities/*/
cz/*/

# Regenerable per-entity profiles — see pipeline/config/data_layers.json.
# 6,267 files rebuilt by pipeline/transforms/build_municipal_public_site.py, which clears and
# recreates the directory; verified byte-identical. Fetched at runtime by the Czech pages and
# served by the API, so the build hydrates it and checks it against data/manifest.v1.json.
data/entities/

# Public serving snapshots — build output, not source. Each release writes a timestamped
# bundle of profile objects under .public-serving/<stamp>/, and four of them already come to
# 3.3 GB. They are produced by scripts/prepare-public-serving-snapshots.mjs from layers that
# are themselves tracked or hydrated, so nothing here is the only copy of anything.
.public-serving/

# Complete normalized CityVizor serving releases. They are built deterministically
# from the verified source cache, validated, and uploaded under an immutable GCS
# release prefix. The compact release descriptor and current pointer stay tracked.
data/cityvizor-explorer/v1/

# Warehouse load staging — NDJSON built by the load-municipal-facts-* scripts and handed to
# `bq load`. Regenerable from the source cache, and the warehouse is where it belongs.
.warehouse-staging/

# Warehouse-built municipal profiles, consumed by prepare-public-serving-snapshots.mjs when a
# country's headline rules reproduce every figure the site publishes. Rebuilt from BigQuery by
# scripts/build-profiles-from-warehouse.mjs --all-ready.
.warehouse-profiles/

# Per-entity municipal fan-out restored by scripts/hydrate-municipal-fanout.py from the
# immutable raw copies pinned in pipeline/config/municipal-serving-inputs.v1.json.
/.municipal-fanout/
# The fan-out itself is not tracked: 6,254 history files and 1,010 benchmark profiles, the
# snapshot builder's inputs only. The small indexes stay tracked because the site serves them
# (data/municipal-history/index.json, data/municipal-benchmarks/<cc>.json).
/data/municipal-history/[0-9]*.json
/data/municipal-benchmarks/*/

# Slim warehouse profiles — identity, history and headline, with detail served by
# /public-data/municipality-lines rather than repeated in every file. Rebuilt by
# scripts/build-profiles-from-warehouse.mjs --slim.
.warehouse-slim/

# Bundled warehouse profiles — one NDJSON per country. Hydration cost is per-file, so 17 files
# beat 65,920 of the same data. Rebuilt with --slim --bundle.
.warehouse-bundle/

# Resumable download checkpoints (Hlídač státu contract pages and similar). Regenerable from
# the source API; the published dataset lives under data/contracts/.
.cache/

# Industry country payloads are committed compressed and hydrated in Cloud Build.
/data/industry/*.json
!/data/industry/index.json
!/data/industry/archive-manifest.json

# Immutable PAQ payloads are hydrated from a checksum-pinned GCS archive.
/data/paq/*.json.gz

# Pinned automotive serving data is hydrated on Cloud Build; local tests use fixtures.
/data/trade/automotive-monthly.v1.json

# OS, editor and backup files
