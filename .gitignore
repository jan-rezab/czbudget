# Local task notes
/BACKFILL_REPORT_*.md
/CODEX_TASK_*.md

# Static data packs: published to gs://czbudget-janrezab-public-snapshots/static-assets
# by the data plane and served from there; never part of the image or a web build.
# The release manifest still checks the three small contract files re-included below.
/data/isred/
/data/industrial-intelligence/
/data/czech-nku/
/data/czech-project-geography/
/data/contracts/*
!/data/contracts/country-parity.schema.json
!/data/contracts/official-registry/
/data/contracts/official-registry/*
!/data/contracts/official-registry/manifest.v1.json
!/data/contracts/official-registry/lineage.v1.json
/data/industry/*

# Served from static-asset packs (published 27 Sep 2026); see deployment-receipts.
/data/monitor-2026/
/data/dotaceeu/
/data/mv-administration-grants/
/data/mf-perimeter-history/
/data/france-municipal-profiles/*
# The Paris profile stays tracked: scripts/validate-site.mjs checks its content.
!/data/france-municipal-profiles/75.v1.json

# Repository datasets moved to the same packs on 27 September 2026 (ASSET_PATH in
# server/static-assets.mjs). Validators and tests read them from the static-asset lock
# through scripts/lib/static-asset-source.mjs; publish changes from a data branch.
/data/countries/
/data/public-entities/
/data/economy/
/data/international-municipalities/
/data/czech-sfdi-tables/
/data/monitor-grants/
/data/registry/source-provenance/
/data/paq/
/data/international-municipalities.v1.json
/data/municipal-snapshot.v1.json
/data/municipal-history-directory.v1.json
/data/cze-medicine-reimbursements.v1.json
/data/cze-school-funding-2026.v1.json
/data/czech-consolidated-accounts.v1.json
/data/czech-sfdi-financing.v1.json
/data/pensions-today.v1.json
/data/methodology-sources.v1.json
/data/eu-budget-flows.v1.json
/data/sovereign-benchmark-slim.v1.json
