#!/bin/sh
set -eu

# Pushes to main trigger a production deploy, so this hook runs the gates that
# are cheap locally plus the one gate CI cannot run at all (source-asset
# verification, whose raw inputs live outside the repo). Roughly 30-45s total.

cd "$(git rev-parse --show-toplevel)"

# Reject synthetic local-only identities before they can appear on GitHub or
# trigger the production build. Existing remote history is excluded so old
# commits do not prevent legitimate branches from being pushed.
zero_oid=0000000000000000000000000000000000000000
push_to_main=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero_oid" ] && continue
  if [ "$remote_ref" = "refs/heads/main" ]; then push_to_main=1; main_oid="$local_oid"; fi

  if [ "$remote_oid" = "$zero_oid" ]; then
    commits=$(git rev-list "$local_oid" --not --remotes=origin)
  else
    commits=$(git rev-list "$remote_oid..$local_oid")
  fi

  for commit in $commits; do
    identities=$(git show -s --format='%ae%n%ce' "$commit")
    if printf '%s\n' "$identities" | grep -Eq '@local$'; then
      echo "Push blocked: commit $commit uses a synthetic @local author or committer identity." >&2
      echo "Configure a real repository user.name and user.email, then recreate that commit." >&2
      exit 1
    fi
  done
done

if [ -n "$(git status --porcelain)" ]; then
  echo "Push blocked: commit or discard local changes first." >&2
  exit 1
fi

# A source-only checkout must not restore multi-gigabyte data to the Mac just
# to push code. Main requires a successful run of this exact commit through
# the canonical trigger; branch builds execute every gate and skip promotion.
if [ "$(git config --bool core.sparseCheckout || true)" = true ] || ! node scripts/check-local-data-layers.mjs; then
  echo "pre-push: cloud-only checkout; running source-safe gates"
  node --test tests/api/static-assets.spec.mjs tests/api/pinned-release.spec.mjs
  node --test tests/api/process-log-store.spec.mjs
  python3 -m unittest tests.test_deployment_event
  node scripts/build-run-log.mjs
  python3 -m unittest discover -s tests -p test_runtime_assets.py
  node pipeline/create-source-manifest.mjs --self-check
  grep -q 'node scripts/validate-integrity.mjs --write-report' cloudbuild.yaml
  grep -q 'npx playwright test --workers=4 --max-failures=5' cloudbuild.yaml
  if [ "$push_to_main" = 1 ]; then
    verified_build=$(gcloud builds list --project=czbudget-janrezab --region=europe-west1 \
      --filter="status=SUCCESS AND buildTriggerId=1df78a8f-7665-4b29-b9f7-65b9c8a9dd42 AND substitutions.COMMIT_SHA=$main_oid" \
      --limit=1 --format='value(id)')
    if [ -z "$verified_build" ]; then
      echo "Push blocked: run the canonical Cloud Build trigger against this branch commit before promoting it to main." >&2
      exit 1
    fi
    echo "pre-push: exact commit passed the full cloud gates in $verified_build"
  else
    echo "pre-push: source-only checks passed; full data/API/browser gates are required in Cloud Build before main"
  fi
  exit 0
fi

echo "pre-push: site + data integrity"
npm run validate

echo "pre-push: API contract tests"
npm run test:api

# The complete browser suite runs in Cloud Build against the actual release
# snapshot. Do not launch a desktop browser from a Git hook on the user's Mac.
# Fail closed if the production configuration stops carrying this release gate.
if [ "$push_to_main" = 1 ]; then
  if ! grep -Eq 'npx playwright test --workers=[1-9][0-9]* --max-failures=[1-9][0-9]*' cloudbuild.yaml; then
    echo "Push blocked: the full Cloud Build browser gate is missing." >&2
    exit 1
  fi
  echo "pre-push: full browser suite is required in Cloud Build before deployment"
fi

# The ~61k source files behind pipeline/source-assets.manifest.json are not in
# git. Since the cloud migration, partial directories on the Mac do not prove
# that the immutable input set is complete. Byte-level verification therefore
# requires an explicitly identified hydrated workspace.
if [ -n "${CZBUDGET_WORKSPACE_ROOT:-}" ]; then
  echo "pre-push: source asset manifest"
  node pipeline/create-source-manifest.mjs --verify
else
  echo "pre-push: source asset manifest self-check (raw inputs are cloud-only)"
  echo "pre-push: set CZBUDGET_WORKSPACE_ROOT to an explicitly hydrated workspace for byte-level verification." >&2
  node pipeline/create-source-manifest.mjs --self-check
fi

# Python deps are optional locally; CI gates these hard. Skip loudly if absent.
if python3 -c "import openpyxl, requests" >/dev/null 2>&1; then
  echo "pre-push: pipeline unit tests"
  python3 -m unittest discover -s pipeline/tests -p 'test_*.py'
else
  echo "pre-push: SKIPPING pipeline unit tests - install with 'python3 -m pip install -r pipeline/requirements.txt'" >&2
fi
