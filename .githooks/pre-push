#!/bin/sh
set -eu

# Pushes run source contracts locally. Mandatory published-data and browser
# verification remains in the existing production build before deployment.

cd "$(git rev-parse --show-toplevel)"

# Reject synthetic local-only identities before they can appear on GitHub or
# trigger the production build. Existing remote history is excluded so old
# commits do not prevent legitimate branches from being pushed.
zero_oid=0000000000000000000000000000000000000000
push_to_main=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero_oid" ] && continue
  if [ "$remote_ref" = "refs/heads/main" ]; then push_to_main=1; main_oid="$local_oid"; main_base="$remote_oid"; fi

  if [ "$remote_oid" = "$zero_oid" ]; then
    commits=$(git rev-list "$local_oid" --not --remotes=origin)
  else
    commits=$(git rev-list "$remote_oid..$local_oid")
  fi

  for commit in $commits; do
    identities=$(git show -s --format='%ae%n%ce' "$commit")
    if printf '%s\n' "$identities" | grep -Eq '@local$'; then
      echo "Push blocked: commit $commit uses a synthetic @local author or committer identity." >&2
      echo "Configure a real repository user.name and user.email, then recreate that commit." >&2
      exit 1
    fi
  done
done

if [ -n "$(git status --porcelain)" ]; then
  echo "Push blocked: commit or discard local changes first." >&2
  exit 1
fi

# Keep local work source-only. Full data integrity and browser integration run
# once in the cloud; never restore datasets to this Mac to push a chart edit.
echo "pre-push: shared component and source contracts"
node scripts/build-chart-assets.mjs --check --tracked
node scripts/validate-chart-ownership.mjs
node scripts/build-chart-coverage.mjs --check
node scripts/validate-ui-environment.mjs
node scripts/validate-release-contract.mjs
(
  ui_context=$(mktemp -d "${TMPDIR:-/tmp}/psd-ui-prepush.XXXXXX")
  trap 'rm -rf -- "$ui_context"' EXIT
  node scripts/prepare-ui-build-context.mjs "$ui_context"
  cd "$ui_context"
  node scripts/validate-ui-environment.mjs
  node scripts/validate-release-contract.mjs
)
node scripts/publish-stories.mjs --check
node --test tests/unit/chart-renderer.spec.mjs tests/unit/chart-registry.spec.mjs tests/unit/release-contract.spec.mjs tests/unit/verification-plan.spec.mjs tests/unit/verification-plan-sparse.spec.mjs tests/unit/ui-build-context.spec.mjs tests/unit/stories.spec.mjs tests/unit/bounded-command.spec.mjs tests/unit/pre-push-data-boundary.spec.mjs
python3 -m unittest tests.test_cloud_verification
node scripts/validate-build-planes.mjs
node pipeline/create-source-manifest.mjs --self-check

# Report catalogue validation uses committed source metadata only.
npm run -s validate:reports-index

# Dataset-dependent politics/accountability/registry/site/API/integrity checks
# remain mandatory in cloudbuild.yaml full-verification after published hydration:
# npm run test:api and PSD_BUILD_MODE=local npm run validate. Never restore data
# locally merely to push source code. The production lane/verification is unchanged.

if [ "$push_to_main" = 1 ]; then
  plan=$(mktemp "${TMPDIR:-/tmp}/psd-verification-plan.XXXXXX")
  trap 'rm -f -- "$plan"' EXIT INT TERM
  node scripts/verification-plan.mjs "$main_base" "$main_oid" > "$plan"
  node scripts/local-browser-gate.mjs "$plan"
  if [ "$(node scripts/release-verification.mjs "$plan")" = full ]; then
    echo "pre-push: full lane; the production build runs the exhaustive suite (about 18 minutes) and blocks deployment on failure"
  else
    echo "pre-push: component lane; focused tests run inside the production build (about 4 minutes) and block deployment on failure"
  fi
else
  node scripts/local-browser-gate.mjs
  echo "pre-push: source contracts passed"
fi
