map "$arg_code:$arg_lang" $legacy_country_path {
  default "/countries/czechia";
  ":cs" "/countries/czechia?lang=cs";
  ":en" "/countries/czechia?lang=en";
  "CZE:" "/countries/czechia";
  "CZE:cs" "/countries/czechia?lang=cs";
  "CZE:en" "/countries/czechia?lang=en";
  "DEU:" "/countries/germany";
  "DEU:cs" "/countries/germany?lang=cs";
  "DEU:en" "/countries/germany?lang=en";
  "DNK:" "/countries/denmark";
  "DNK:cs" "/countries/denmark?lang=cs";
  "DNK:en" "/countries/denmark?lang=en";
  "FRA:" "/countries/france";
  "FRA:cs" "/countries/france?lang=cs";
  "FRA:en" "/countries/france?lang=en";
  "GBR:" "/countries/united-kingdom";
  "GBR:cs" "/countries/united-kingdom?lang=cs";
  "GBR:en" "/countries/united-kingdom?lang=en";
  "POL:" "/countries/poland";
  "POL:cs" "/countries/poland?lang=cs";
  "POL:en" "/countries/poland?lang=en";
  "SWE:" "/countries/sweden";
  "SWE:cs" "/countries/sweden?lang=cs";
  "SWE:en" "/countries/sweden?lang=en";
  "CHE:" "/countries/switzerland";
  "CHE:cs" "/countries/switzerland?lang=cs";
  "CHE:en" "/countries/switzerland?lang=en";
  "UKR:" "/countries/ukraine";
  "UKR:cs" "/countries/ukraine?lang=cs";
  "UKR:en" "/countries/ukraine?lang=en";
  "USA:" "/countries/united-states";
  "USA:cs" "/countries/united-states?lang=cs";
  "USA:en" "/countries/united-states?lang=en";
}

map $request_uri $country_canonical_path {
  default "/countries/czechia";
  ~^(?<country_path>/countries/(?:czechia|germany|denmark|france|united-kingdom|poland|sweden|switzerland|ukraine|united-states))(?:\?|$) $country_path;
}

server {
  listen ${PORT};
  server_name publicspendingdata.org www.publicspendingdata.org _;
  absolute_redirect off;
  root /usr/share/nginx/html;
  index index.html;

  if ($host = www.publicspendingdata.org) {
    return 308 https://publicspendingdata.org$request_uri;
  }

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests" always;

  location ~ ^/cz/obce(?:/(.*))?$ {
    return 301 /cz/municipalities/$1$is_args$args;
  }

  location = /cz-obce.html {
    return 301 /cz/municipalities/$is_args$args;
  }

  location = /country.html {
    return 301 $legacy_country_path;
  }

  location ~ ^/countries/(czechia|germany|denmark|france|united-kingdom|poland|sweden|switzerland|ukraine|united-states)/$ {
    return 301 /countries/$1$is_args$args;
  }

  location ~ ^/countries/(czechia|germany|denmark|france|united-kingdom|poland|sweden|switzerland|ukraine|united-states)$ {
    sub_filter_once off;
    sub_filter 'https://publicspendingdata.org/countries/czechia' 'https://publicspendingdata.org$country_canonical_path';
    try_files /country.html =404;
  }

  location / {
    sub_filter_once off;
    sub_filter '<head>' '<head><script src="/language-bootstrap.js?v=20260822-no-language-flash"></script>';
    sub_filter 'cz-budget.css"' 'cz-budget.css?v=20260823-municipal-ux2"';
    sub_filter 'municipal-i18n.js"' 'municipal-i18n.js?v=20260823-english-route"';
    sub_filter 'cz-municipal-directory.js"' 'cz-municipal-directory.js?v=20260823-english-route"';
    sub_filter 'cz-history.js"' 'cz-history.js?v=20260824-history-views"';
    sub_filter 'municipal-benchmark-profile.css"' 'municipal-benchmark-profile.css?v=20260824-box-sizing"';
    sub_filter 'global-nav.js?v=20260822-component"' 'global-nav.js?v=20260824-archivo-lockup"';
    sub_filter 'global-nav.js?v=20260824-identity-outlines"' 'global-nav.js?v=20260824-archivo-lockup"';
    sub_filter 'assets/favicon.svg"' 'assets/favicon.svg?v=20260824-archivo-lockup"';
    try_files $uri $uri/ $uri/index.html =404;
  }

  location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|json)$ {
    expires 1h;
    try_files $uri =404;
  }

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
