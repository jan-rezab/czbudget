map "$arg_code:$arg_lang" $legacy_country_path {
  default "/countries/czechia";
  ":cs" "/countries/czechia?lang=cs";
  ":en" "/countries/czechia?lang=en";
  "CZE:" "/countries/czechia";
  "CZE:cs" "/countries/czechia?lang=cs";
  "CZE:en" "/countries/czechia?lang=en";
  "DEU:" "/countries/germany";
  "DEU:cs" "/countries/germany?lang=cs";
  "DEU:en" "/countries/germany?lang=en";
  "DNK:" "/countries/denmark";
  "DNK:cs" "/countries/denmark?lang=cs";
  "DNK:en" "/countries/denmark?lang=en";
  "FIN:" "/countries/finland";
  "FIN:cs" "/countries/finland?lang=cs";
  "FIN:en" "/countries/finland?lang=en";
  "FRA:" "/countries/france";
  "FRA:cs" "/countries/france?lang=cs";
  "FRA:en" "/countries/france?lang=en";
  "GBR:" "/countries/united-kingdom";
  "GBR:cs" "/countries/united-kingdom?lang=cs";
  "GBR:en" "/countries/united-kingdom?lang=en";
  "POL:" "/countries/poland";
  "POL:cs" "/countries/poland?lang=cs";
  "POL:en" "/countries/poland?lang=en";
  "SWE:" "/countries/sweden";
  "SWE:cs" "/countries/sweden?lang=cs";
  "SWE:en" "/countries/sweden?lang=en";
  "CHE:" "/countries/switzerland";
  "CHE:cs" "/countries/switzerland?lang=cs";
  "CHE:en" "/countries/switzerland?lang=en";
  "UKR:" "/countries/ukraine";
  "UKR:cs" "/countries/ukraine?lang=cs";
  "UKR:en" "/countries/ukraine?lang=en";
  "USA:" "/countries/united-states";
  "USA:cs" "/countries/united-states?lang=cs";
  "USA:en" "/countries/united-states?lang=en";
  "BRA:" "/countries/brazil";
  "BRA:cs" "/countries/brazil?lang=cs";
  "BRA:en" "/countries/brazil?lang=en";
  "ESP:" "/countries/spain";
  "ESP:cs" "/countries/spain?lang=cs";
  "ESP:en" "/countries/spain?lang=en";
  "JPN:" "/countries/japan";
  "JPN:cs" "/countries/japan?lang=cs";
  "JPN:en" "/countries/japan?lang=en";
  "NLD:" "/countries/netherlands";
  "NLD:cs" "/countries/netherlands?lang=cs";
  "NLD:en" "/countries/netherlands?lang=en";
  "NOR:" "/countries/norway";
  "NOR:cs" "/countries/norway?lang=cs";
  "NOR:en" "/countries/norway?lang=en";
  "GRC:" "/countries/greece";
  "GRC:cs" "/countries/greece?lang=cs";
  "GRC:en" "/countries/greece?lang=en";
}

map $request_uri $country_canonical_path {
  default "/countries/czechia";
  ~^(?<country_path>/countries/(?:czechia|germany|denmark|finland|france|united-kingdom|poland|sweden|switzerland|ukraine|united-states|brazil|spain|japan|netherlands|norway|greece|[a-z][a-z][a-z]))(?:\?|$) $country_path;
}

upstream public_spending_api {
  server 127.0.0.1:8081;
  keepalive 32;
}

# $request_uri remains the browser's original request during internal file
# resolution, so clean URLs that resolve to index.html do not redirect-loop.
map $request_uri $index_redirect_path {
  default "";
  ~^(?<index_directory>.*/)index\.html(?:\?|$) $index_directory;
}

# nginx does NOT merge sub_filter directives down location levels: a location
# that declares any sub_filter of its own replaces the entire inherited set. Any
# HTML-serving location must therefore inject this itself, and keeping the
# payload in one map is what stops the blocks from silently drifting apart (the
# /countries/... block previously shipped with no analytics for exactly this
# reason). Every page already loads /language-bootstrap.js as the first child of
# its own <head>, so it is deliberately not injected here - injecting it added a
# second copy under a different ?v, i.e. a duplicate download on every page.
map $host $psd_head_inject {
  default '<head><script defer src="https://cloud.umami.is/script.js" data-website-id="b80e941b-3a25-40ef-bdf4-3ecb0e91e053" data-domains="publicspendingdata.org,www.publicspendingdata.org" data-do-not-track="true" data-exclude-search="true"></script>';
}

server {
  listen ${PORT};
  server_name publicspendingdata.org www.publicspendingdata.org _;
  absolute_redirect off;
  root /usr/share/nginx/html;
  index index.html;

  if ($host = www.publicspendingdata.org) {
    return 308 https://publicspendingdata.org$request_uri;
  }

  if ($index_redirect_path != "") {
    return 301 $index_redirect_path$is_args$args;
  }

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://cloud.umami.is https://gateway.umami.is; font-src 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests" always;

  client_max_body_size 32k;

  location = /healthz {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /api {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /api/ {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /public-data/ {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /auth/ {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /docs {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /docs/ {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /developers {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /developers/ {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~ ^/cz/obce(?:/(.*))?$ {
    return 301 /cz/municipalities/$1$is_args$args;
  }

  location = /cz-obce.html {
    return 301 /cz/municipalities/$is_args$args;
  }

  location = /country.html {
    return 301 $legacy_country_path;
  }

  location ~ ^/countries/(czechia|germany|denmark|finland|france|united-kingdom|poland|sweden|switzerland|ukraine|united-states|brazil|spain|japan|netherlands|norway|greece|[a-z][a-z][a-z])/$ {
    return 301 /countries/$1$is_args$args;
  }

  location ~ ^/countries/(czechia|germany|denmark|finland|france|united-kingdom|poland|sweden|switzerland|ukraine|united-states|brazil|spain|japan|netherlands|norway|greece|[a-z][a-z][a-z])$ {
    sub_filter_once off;
    sub_filter '<head>' $psd_head_inject;
    sub_filter 'https://publicspendingdata.org/countries/czechia' 'https://publicspendingdata.org$country_canonical_path';
    sub_filter 'global-nav.js?v=20260824-logo-120' 'global-nav.js?v=20260828-education';
    sub_filter 'country-parity.css?v=20260822-parity-contract' 'country-parity.css?v=20260824-readable-country-routes';
    sub_filter 'country-parity.js?v=20260822-parity-contract' 'country-parity.js?v=20260824-readable-country-routes';
    sub_filter 'country-cash-in.js?v=20260824-loaded-layers' 'country-cash-in.js?v=20260824-readable-country-routes';
    sub_filter 'country-spending.js?v=20260824-dashboard-sections' 'country-spending.js?v=20260824-readable-country-routes';
    sub_filter 'country-insights.js?v=20260824-dashboard-sections' 'country-insights.js?v=20260824-readable-country-routes';
    sub_filter 'country-public-entities.js?v=20260823-public-registry-2' 'country-public-entities.js?v=20260824-readable-country-routes';
    sub_filter 'country-functions.js?v=20260822-transport-deep-dive' 'country-functions.js?v=20260824-readable-country-routes';
    sub_filter 'country-health.js?v=20260822-czech-flow' 'country-health.js?v=20260824-readable-country-routes';
    sub_filter 'country-health-performance.js?v=20260824-performance' 'country-health-performance.js?v=20260824-readable-country-routes';
    sub_filter 'country-providers.js?v=20260822-network' 'country-providers.js?v=20260824-readable-country-routes';
    try_files /country.html =404;
  }

  # The slug group must not match "index.html". When nginx resolves a hub
  # directory (/municipalities/france/ or /cz/municipalities/) through `index`,
  # the internal URI becomes .../index.html -- which this location matched, so it
  # 301'd to .../index.html/ and dead-ended in a 404. That took every country hub
  # and the Czech directory offline while the profile routes, which match their
  # own location, kept working.
  location ~ ^/(?:municipalities/[^/]+/(?!index\.html$)[^/]+|cz/municipalities/(?!index\.html$)[^/]+)$ {
    return 301 $uri/$is_args$args;
  }

  # These two templates select a municipality with ?code=; they are not
  # per-entity snapshot paths. Keep them ahead of the dynamic profile rule.
  location ~ ^/municipalities/(france|germany)/profile/$ {
    sub_filter_once off;
    sub_filter '<head>' $psd_head_inject;
    try_files ${uri}index.html =404;
  }

  location ~ ^/(?:municipalities/[^/]+/[^/]+|cz/municipalities/[^/]+)/$ {
    sub_filter_once off;
    sub_filter '<head>' $psd_head_inject;
    # Profile HTML is rendered from the immutable snapshot. A stale generated
    # index.html in a developer checkout must never shadow the active release.
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location @municipality_profile {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    sub_filter_once off;
    sub_filter '<head>' $psd_head_inject;
    sub_filter 'cz-budget.css"' 'cz-budget.css?v=20260823-municipal-ux2"';
    sub_filter 'municipal-i18n.js"' 'municipal-i18n.js?v=20260823-english-route"';
    sub_filter 'cz-history.js"' 'cz-history.js?v=20260824-history-views"';
    sub_filter 'municipal-benchmark-profile.css"' 'municipal-benchmark-profile.css?v=20260824-box-sizing"';
    sub_filter 'municipal-expanded-profile.css"' 'municipal-expanded-profile.css?v=20260827-unified-municipal-profile"';
    sub_filter 'municipal-expanded-profile.js"' 'municipal-expanded-profile.js?v=20260827-unified-municipal-profile"';
    sub_filter 'global-nav.js?v=20260822-component"' 'global-nav.js?v=20260828-education"';
    sub_filter 'global-nav.js?v=20260824-budget-stages"' 'global-nav.js?v=20260828-education"';
    sub_filter 'global-nav.js?v=20260824-identity-outlines"' 'global-nav.js?v=20260828-education"';
    sub_filter 'global-nav.js?v=20260824-logo-120' 'global-nav.js?v=20260828-education';
    sub_filter 'global-footer.js?v=20260822-hlidac' 'global-footer.js?v=20260825-footer-align';
    sub_filter 'global-footer.js?v=20260823-footer' 'global-footer.js?v=20260825-footer-align';
    sub_filter 'global-footer.js?v=20260824-compact' 'global-footer.js?v=20260825-footer-align';
    sub_filter 'global-footer.css?v=20260822-hlidac' 'global-footer.css?v=20260825-footer-align';
    sub_filter 'global-footer.css?v=20260824-dark' 'global-footer.css?v=20260825-footer-align';
    sub_filter 'homepage-v2.js?v=20260822-separate-pages' 'homepage-v2.js?v=20260825-country-expansion';
    sub_filter 'homepage-category.js?v=20260821-benchmark-flags' 'homepage-category.js?v=20260824-language-contract';
    sub_filter 'homepage-health-performance.js?v=20260824-topline-compare' 'homepage-health-performance.js?v=20260824-language-contract';
    sub_filter 'ageing-bill.js?v=20260824-ageing' 'ageing-bill.js?v=20260824-readable-country-routes';
    sub_filter 'assets/favicon.svg"' 'assets/favicon.svg?v=20260824-archivo-lockup"';
    sub_filter 'site-header.css?v=20260824-header-lockup"' 'site-header.css?v=20260902-municipal-depth"';
    sub_filter 'site-header.css?v=20260822-component"' 'site-header.css?v=20260902-municipal-depth"';
    try_files $uri $uri/ $uri/index.html =404;
  }

  # The two payload trees the pages fetch by file path. They are no longer in the image — the
  # release holds them — so they need the same fallback the profile pages have. Scoped to these
  # prefixes on purpose: the generic .json rule below must keep answering 404 for a file that
  # genuinely is not there, or every typo becomes a proxied request.
  # Spelled out rather than quantified: nginx reads an unquoted {3} as a block, and the
  # exact digit count is enforced by the API behind this anyway.
  location ~ ^/(?:data/municipal-expansion/[a-z][a-z][a-z]/[^/]+\.json|data/entities/[0-9]+\.json)$ {
    expires 1h;
    try_files $uri @municipality_payload;
  }

  location @municipality_payload {
    proxy_pass http://public_spending_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|json)$ {
    expires 1h;
    try_files $uri =404;
  }

  # Compression. Level 1 (the nginx default) left the 11 MB Czech municipal snapshot at
  # 1.95 MB on the wire; level 6 brings it to 1.48 MB for a few ms of CPU. gzip_static goes
  # further for anything the image build precompressed at level 9 (see the Dockerfiles):
  # nginx then serves the ready-made .gz next to the file and spends no CPU at all.
  # gzip_proxied is what compresses the Node API's responses on the way out of the
  # container - Cloudflare recompresses for browsers either way, but origin egress was
  # leaving uncompressed (a municipality-lines response is 305 kB raw, 20 kB gzipped).
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_vary on;
  gzip_static on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
