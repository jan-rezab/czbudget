    "audit:links": "node scripts/check-external-links.mjs --write-report",
    "backfill:social-previews": "node scripts/backfill-social-previews.mjs",
    "test:api": "node --test tests/api/*.spec.mjs",
    "test:browser": "playwright test",
    "test": "npm run validate && npm run test:api && npm run test:browser",
    "validate:invariants": "node scripts/validate-invariants.mjs",
    "data:layers:report": "node scripts/build-layer-manifest.mjs --report",
    "data:layers:manifest": "node scripts/build-layer-manifest.mjs",
    "build:country-registry": "node scripts/build-country-registry.mjs --write",
    "report:country-registry": "node scripts/build-country-registry.mjs --report",
    "build:transform-graph": "node scripts/build-transform-graph.mjs --write",
    "report:transform-graph": "node scripts/build-transform-graph.mjs",
    "build:source-provenance": "node scripts/build-source-provenance.mjs --write",
    "build:item-labels": "node scripts/build-municipal-item-labels.mjs --write",
    "report:source-provenance": "node scripts/build-source-provenance.mjs",
    "build:municipal-entities": "node scripts/build-municipal-entity-directory.mjs --write",
    "report:municipal-entities": "node scripts/build-municipal-entity-directory.mjs",
    "report:headline-rules": "node scripts/derive-municipal-headline-rules.mjs --all",
    "report:warehouse-profiles": "node scripts/build-profiles-from-warehouse.mjs --country CRI --verify",
    "fetch:brazil-dca": "python3 scripts/fetch-brazil-dca-2024.py --fetch",
    "report:brazil-dca": "python3 scripts/load-municipal-facts-bra-dca.py --report",
    "build:warehouse-profiles": "node scripts/build-profiles-from-warehouse.mjs --all-ready --out .warehouse-profiles",
    "report:japan-hierarchy": "node scripts/derive-japan-hierarchy.mjs",
    "fetch:denmark-regk100": "python3 scripts/fetch-denmark-regk100.py --fetch",
    "report:denmark-regk100": "python3 scripts/load-municipal-facts-dnk.py --report",
    "report:japan-estat": "python3 scripts/load-municipal-facts-jpn-estat.py --report",
    "validate:glossary": "node scripts/validate-glossary.mjs",
    "report:france-ofgl": "python3 scripts/load-municipal-facts-fra-ofgl.py --report",
    "build:source-vintages": "node scripts/build-source-vintages.mjs --write",
    "report:source-vintages": "node scripts/build-source-vintages.mjs",
    "report:economic-observations": "python3 scripts/load-economic-observations.py --report",
    "build:warehouse-bundles": "node scripts/build-profiles-from-warehouse.mjs --all-ready --slim --bundle --out .warehouse-bundle"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1"
  }
}
