{
  "name": "czbudget-integrity",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "build:municipality-countries": "node scripts/build-municipality-country-pages.mjs",
    "build:municipal-itemized-coverage": "node scripts/build-municipal-itemized-coverage.mjs",
    "build:municipal-budget-structure": "node scripts/build-municipal-budget-structure.mjs",
    "build:functional-budgets": "node scripts/build-country-functional-budgets.mjs",
    "build:transport-budgets": "node scripts/build-transport-budget-detail.mjs",
    "build:transport-performance": "node scripts/build-transport-performance.mjs",
    "build:country-cash-in": "node scripts/build-country-cash-in.mjs",
    "build:country-revenue": "python3 scripts/build-country-revenue.py",
    "build:country-health": "node scripts/build-country-health-data.mjs && node scripts/build-country-health-performance.mjs && node scripts/build-country-provider-networks.mjs",
    "build:country-spending": "python3 scripts/build-country-spending.py && node scripts/build-country-spending-comparison.mjs",
    "build:country-demography": "python3 scripts/build-country-demography.py",
    "build:country-economy": "python3 scripts/build-country-economy.py",
    "build:demographic-pressure": "python3 scripts/build-demographic-pressure.py",
    "build:eu-migration": "node scripts/build-eu-migration.mjs",
    "build:defense": "python3 scripts/build-defense-deep-dive.py",
    "build:data-freshness": "node scripts/build-data-freshness.mjs",
    "build:country-parity": "node scripts/build-country-parity.mjs",
    "build:public-entities-web": "python3 pipeline/transforms/build_public_entity_frontend.py",
    "build:public-entity-history": "python3 pipeline/transforms/build_public_entity_web_dataset.py",
    "fix:benchmark-canonicals": "node scripts/backfill-benchmark-canonicals.mjs",
    "build:methodology": "node scripts/build-methodology-sources.mjs",
    "validate": "node scripts/validate-site.mjs && node scripts/validate-integrity.mjs",
    "validate:data": "node scripts/validate-integrity.mjs --data-only",
    "audit:links": "node scripts/check-external-links.mjs --write-report",
    "backfill:social-previews": "node scripts/backfill-social-previews.mjs",
    "test:api": "node --test tests/api/*.spec.mjs",
    "test:browser": "playwright test",
    "test": "npm run validate && npm run test:api && npm run test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1"
  }
}
