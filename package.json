    "build:education": "python3 scripts/build-education-deep-dive.py",
    "build:data-freshness": "node scripts/build-data-freshness.mjs",
    "build:country-parity": "node scripts/build-country-parity.mjs",
    "build:country-sitemap": "node scripts/build-country-sitemap.mjs",
